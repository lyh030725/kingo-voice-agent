# Copy to .env — Week 1 values plus Moss semantic-memory settings.
# NEVER commit a real key.

# From https://console.x.ai (you set this up in week 1).
XAI_API_KEY=

# Grok chat model (OpenAI SDK). Check https://docs.x.ai for current names.
CHAT_MODEL=grok-4.3
CHAT_REASONING_EFFORT=none
CHAT_MAX_TOKENS=1200

# Week 4 native Speech-to-Speech. The latest alias follows xAI upgrades.
GROK_VOICE_MODEL=grok-voice-latest
GROK_VOICE=eve

# --- Moss semantic memory (https://portal.usemoss.dev) --------------------
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# One cloud-backed index per student/tenant. Keep model stable after creation.
MOSS_MEMORY_INDEX=kingo-voice-agent-weak-concepts
MOSS_MEMORY_MODEL=moss-minilm
MOSS_STUDENT_ID=default-student

# Local writes return immediately; cloud persistence is debounced in background.
MOSS_SYNC_DEBOUNCE_SECONDS=0.75

# --- Optional ---------------------------------------------------------------
XAI_BASE_URL=https://api.x.ai/v1
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime

# --- Realtime server VAD ---
VAD_THRESHOLD=0.5
SILENCE_MS=900
PREFIX_MS=300
